# EVO-X3 homelab settings.
# install.sh copies this to ~/.config/evo/evo.env the first time it runs.
# Edit that copy, not this file, then re-run `./install.sh user` to apply.
# Secrets are kept separately in ~/.config/evo/secrets.env, which install.sh
# generates and which is never committed.

# ---- Unified memory -------------------------------------------------------
# How many GiB of the 128 GB the GPU may borrow from system RAM (GTT).
# Keep BIOS "UMA Frame Buffer" at its minimum (512 MB) and set this instead.
# 120 leaves ~8 GiB that the GPU can never take. Below 112 wastes memory;
# above 124 risks the desktop being starved when a large model is loaded.
EVO_GTT_GIB=120

# llama-swap capacity pool in GiB. It decides which models may be loaded at
# the same time. Keep it a few GiB under EVO_GTT_GIB so the desktop, games and
# Open WebUI's own embeddings still have room.
EVO_GPU_POOL_GIB=112

# Disable the IOMMU: 5-12% faster token generation, but the NPU stops working
# and you lose DMA protection for Thunderbolt/OCuLink devices.
# Set to false if you plan to use the NPU or attach untrusted devices.
EVO_DISABLE_IOMMU=true

# ---- Identity ----------------------------------------------------------------
EVO_HOSTNAME=evo-x3        # LAN name: http://evo-x3.local

# ---- Paths -----------------------------------------------------------------
EVO_AI_DIR="$HOME/ai"
EVO_MODELS_DIR="$HOME/ai/models"
EVO_COMFY_DIR="$HOME/ai/comfy"

# ---- Network ports (all on the LAN unless noted) ---------------------------
EVO_LLAMA_SWAP_PORT=8080   # OpenAI/Anthropic-compatible API + llama-swap UI
EVO_WEBUI_PORT=3000        # Open WebUI (chat for the household)
EVO_GRAFANA_PORT=3001      # Monitoring dashboards
EVO_SEARXNG_PORT=8888      # Web search, bound to 127.0.0.1 only
EVO_PROMETHEUS_PORT=9091   # Metrics database, bound to 127.0.0.1 only (9090 is Cockpit)
EVO_NODE_EXPORTER_PORT=9100 # Host metrics, bound to 127.0.0.1 only

# ---- Inference images ------------------------------------------------------
# kyuz0's Strix Halo builds: Vulkan RADV is the stable default, ROCm is often
# faster at prompt processing. Each model in llama-swap picks one.
EVO_IMG_VULKAN=docker.io/kyuz0/amd-strix-halo-toolboxes:vulkan-radv
EVO_IMG_ROCM=docker.io/kyuz0/amd-strix-halo-toolboxes:rocm-10.0
EVO_IMG_COMFYUI=docker.io/kyuz0/amd-strix-halo-comfyui:latest
EVO_IMG_UNIFIED=ghcr.io/mostlygeek/llama-swap:unified-vulkan
EVO_IMG_KOKORO=ghcr.io/remsky/kokoro-fastapi-cpu:latest

# ---- Model profile -----------------------------------------------------------
# Which llama-swap profile is active after boot: smart | fast | multi
EVO_DEFAULT_PROFILE=smart

# ---- Power / modes ------------------------------------------------------------
# TuneD profiles used by `evo mode`. Bazzite ships the *-bazzite variants.
EVO_TUNED_SERVER=balanced-bazzite
EVO_TUNED_GAME=throughput-performance-bazzite
EVO_TUNED_QUIET=powersave-bazzite

# ---- Backups (restic + rclone) ------------------------------------------------
# rclone remote name and folder. Create the remote with `rclone config`
# (choose "drive" for Google Drive); see docs/07-monitoring-and-backups.md.
EVO_BACKUP_REPO="rclone:gdrive:evo-x3-backups"
EVO_BACKUP_KEEP_DAILY=7
EVO_BACKUP_KEEP_WEEKLY=4
EVO_BACKUP_KEEP_MONTHLY=6

# ---- Memory guard (bin/evo-memguard) -------------------------------------------
# Last line of defence: GPU memory is pinned system RAM that cgroup limits and
# systemd-oomd cannot see, so this watches MemAvailable directly.
# Available RAM below SOFT for 3 s -> unload all models; below HARD (or zram swap
# above SWAP) -> kill the model containers. COOLDOWN stops reload loops.
EVO_MEMGUARD_SOFT_GIB=6
EVO_MEMGUARD_HARD_GIB=3
EVO_MEMGUARD_SWAP_GIB=8
EVO_MEMGUARD_COOLDOWN=30

# ---- Grafana LLM dashboard (bin/evo-exporter) ------------------------------------
EVO_EXPORTER_PORT=9102     # bound to 127.0.0.1 only
# Money-saved estimate (Grafana "EVO-X3 LLM"). Set these to YOUR numbers:
EVO_KWH_PRICE_BRL=0.90     # electricity price, R$ per kWh (check your bill)
EVO_USD_BRL=5.50           # R$ per US$ used to show both currencies (approximate)
EVO_POWER_OVERHEAD_W=15    # wall power the APU sensor misses: PSU losses, SSD, fans, Wi-Fi (estimate)
# Cloud prices the savings are compared against: config/cloud-prices.tsv
