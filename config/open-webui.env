# Open WebUI settings (rendered by install.sh to ~/.config/evo/open-webui.env, mode 600).
# NOTE: most of these are "PersistentConfig": they seed the database on the
# FIRST start only. After that, change them in Admin Panel -> Settings.
# Set ENABLE_PERSISTENT_CONFIG=false to make these values win on every start.
PORT=@EVO_WEBUI_PORT@
WEBUI_NAME=EVO-X3
WEBUI_SECRET_KEY=@WEBUI_SECRET_KEY@
ENABLE_PERSISTENT_CONFIG=true

# Accounts: anyone on the LAN can sign up, an admin must approve them.
ENABLE_SIGNUP=true
DEFAULT_USER_ROLE=pending

# All models come from llama-swap (no Ollama).
ENABLE_OLLAMA_API=false
OPENAI_API_BASE_URLS=http://127.0.0.1:@EVO_LLAMA_SWAP_PORT@/v1
OPENAI_API_KEYS=@LLAMA_SWAP_KEY@
DEFAULT_MODELS=chat

# Web search through the local SearXNG.
ENABLE_WEB_SEARCH=true
WEB_SEARCH_ENGINE=searxng
SEARXNG_QUERY_URL=http://127.0.0.1:@EVO_SEARXNG_PORT@/search?q=<query>
WEB_SEARCH_RESULT_COUNT=5

# Documents / knowledge bases: embeddings from llama-swap.
RAG_EMBEDDING_ENGINE=openai
RAG_OPENAI_API_BASE_URL=http://127.0.0.1:@EVO_LLAMA_SWAP_PORT@/v1
RAG_OPENAI_API_KEY=@LLAMA_SWAP_KEY@
RAG_EMBEDDING_MODEL=qwen3-embedding-0.6b

# Voice: whisper (speech-to-text) and Kokoro (text-to-speech) via llama-swap.
AUDIO_STT_ENGINE=openai
AUDIO_STT_OPENAI_API_BASE_URL=http://127.0.0.1:@EVO_LLAMA_SWAP_PORT@/v1
AUDIO_STT_OPENAI_API_KEY=@LLAMA_SWAP_KEY@
AUDIO_STT_MODEL=whisper-large-v3-turbo
AUDIO_TTS_ENGINE=openai
AUDIO_TTS_OPENAI_API_BASE_URL=http://127.0.0.1:@EVO_LLAMA_SWAP_PORT@/v1
AUDIO_TTS_OPENAI_API_KEY=@LLAMA_SWAP_KEY@
AUDIO_TTS_MODEL=kokoro-tts
AUDIO_TTS_VOICE=pf_dora

# Image generation is configured in the Admin UI (ComfyUI workflow); see docs.
ENABLE_IMAGE_GENERATION=false
