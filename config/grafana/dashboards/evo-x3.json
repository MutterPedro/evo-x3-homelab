{
 "title": "EVO-X3",
 "uid": "evo-x3",
 "tags": [
  "evo-x3"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "editable": true,
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "GPU memory in use (GTT)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 100000000000.0
       },
       {
        "color": "red",
        "value": 120000000000.0
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(node_drm_memory_gtt_used_bytes)"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "GPU busy",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 70
       },
       {
        "color": "red",
        "value": 95
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(node_drm_gpu_busy_percent)"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "APU package power",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "watt",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 90
       },
       {
        "color": "red",
        "value": 130
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(node_hwmon_power_average_watt)"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Hottest sensor",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "celsius",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 80
       },
       {
        "color": "red",
        "value": 92
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(node_hwmon_temp_celsius)"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Unified memory: GPU (GTT) vs system RAM",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "stacking": {
       "mode": "none"
      }
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(node_drm_memory_gtt_used_bytes)",
     "legendFormat": "GPU GTT used"
    },
    {
     "refId": "B",
     "expr": "sum(node_drm_memory_gtt_size_bytes)",
     "legendFormat": "GPU GTT limit"
    },
    {
     "refId": "C",
     "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
     "legendFormat": "System RAM used"
    },
    {
     "refId": "D",
     "expr": "node_memory_MemTotal_bytes",
     "legendFormat": "System RAM total"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "GPU utilisation",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "stacking": {
       "mode": "none"
      }
     },
     "max": 100,
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(node_drm_gpu_busy_percent)",
     "legendFormat": "GPU busy %"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Temperatures",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "celsius",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "stacking": {
       "mode": "none"
      }
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_hwmon_temp_celsius",
     "legendFormat": "{{chip}} {{sensor}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Power draw",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "watt",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "stacking": {
       "mode": "none"
      }
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(node_hwmon_power_average_watt)",
     "legendFormat": "APU package"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "CPU utilisation",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "stacking": {
       "mode": "none"
      }
     },
     "max": 100,
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])))",
     "legendFormat": "CPU %"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Network (all interfaces)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "stacking": {
       "mode": "none"
      }
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(node_network_receive_bytes_total{device!~\"lo|veth.*|podman.*|tailscale.*\"}[1m]))",
     "legendFormat": "receive"
    },
    {
     "refId": "B",
     "expr": "sum(rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|podman.*|tailscale.*\"}[1m]))",
     "legendFormat": "transmit"
    }
   ]
  },
  {
   "id": 11,
   "type": "bargauge",
   "title": "Disk used (/var: models, containers, home)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 12,
    "h": 6
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.7
       },
       {
        "color": "red",
        "value": 0.85
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "showUnfilled": true,
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - node_filesystem_avail_bytes{mountpoint=\"/var\"} / node_filesystem_size_bytes{mountpoint=\"/var\"}",
     "legendFormat": "used"
    }
   ]
  },
  {
   "id": 12,
   "type": "stat",
   "title": "Disk free",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 28,
    "w": 6,
    "h": 6
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 200000000000.0
       },
       {
        "color": "green",
        "value": 500000000000.0
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_filesystem_avail_bytes{mountpoint=\"/var\"}",
     "legendFormat": "free"
    }
   ]
  },
  {
   "id": 13,
   "type": "stat",
   "title": "Days until full (at 7-day trend)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 28,
    "w": 6,
    "h": 6
   },
   "fieldConfig": {
    "defaults": {
     "unit": "d",
     "decimals": 0,
     "noValue": "not shrinking",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 30
       },
       {
        "color": "green",
        "value": 90
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(node_filesystem_avail_bytes{mountpoint=\"/var\"} / -deriv(node_filesystem_avail_bytes{mountpoint=\"/var\"}[7d])) / 86400 and deriv(node_filesystem_avail_bytes{mountpoint=\"/var\"}[7d]) < 0",
     "legendFormat": "days"
    }
   ]
  }
 ],
 "links": [],
 "annotations": {
  "list": [
   {
    "name": "Reboot",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "iconColor": "red",
    "expr": "changes(node_boot_time_seconds[2m]) > 0",
    "step": "60s",
    "titleFormat": "reboot"
   }
  ]
 },
 "templating": {
  "list": []
 },
 "description": "Hardware overview. LLM speed, model comparison and money saved are on the \"EVO-X3 LLM\" dashboard."
}
