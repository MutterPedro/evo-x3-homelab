{
 "uid": "evo-llm",
 "title": "EVO-X3 LLM",
 "tags": [
  "evo-x3",
  "llm"
 ],
 "schemaVersion": 39,
 "version": 1,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "30s",
 "timezone": "browser",
 "graphTooltip": 1,
 "templating": {
  "list": [
   {
    "name": "model",
    "label": "Models",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(evo_model_loaded, model)",
     "refId": "model"
    },
    "definition": "label_values(evo_model_loaded, model)",
    "refresh": 2,
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    },
    "sort": 1
   }
  ]
 },
 "annotations": {
  "list": [
   {
    "name": "Model loaded",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "iconColor": "green",
    "expr": "(evo_model_loaded == 1) and (evo_model_loaded offset 1m == 0)",
    "step": "30s",
    "titleFormat": "{{model}} loaded"
   },
   {
    "name": "Model unloaded",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "iconColor": "gray",
    "expr": "(evo_model_loaded == 0) and (evo_model_loaded offset 1m == 1)",
    "step": "30s",
    "titleFormat": "{{model}} unloaded"
   },
   {
    "name": "Reboot",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "iconColor": "red",
    "expr": "changes(node_boot_time_seconds[2m]) > 0",
    "step": "60s",
    "titleFormat": "reboot"
   },
   {
    "name": "Memory guard",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "iconColor": "orange",
    "expr": "changes(evo_memguard_events_total[1m]) > 0",
    "step": "30s",
    "titleFormat": "memory guard {{level}}"
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "At a glance",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Generating now",
   "description": "Token generation speed of whatever is answering right now. Empty when idle.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "suffix: tok/s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(llamacpp:tokens_predicted_total[1m])) / sum(rate(llamacpp:tokens_predicted_seconds_total[1m])) > 0",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Prompt speed now",
   "description": "How fast the model reads a prompt right now. Empty when idle.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "suffix: tok/s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(llamacpp:prompt_tokens_total[1m])) / sum(rate(llamacpp:prompt_seconds_total[1m])) > 0",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Models loaded",
   "description": "Models resident in memory.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 3,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(evo_model_loaded) or vector(0)",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Requests running",
   "description": "Requests being processed by all loaded models.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 11,
    "y": 1,
    "w": 3,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(llamacpp:requests_processing) or vector(0)",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Free RAM",
   "description": "The number the memory guard watches. Under 6 GiB it unloads models, under 3 GiB it kills them.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 14,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 6442450944
       },
       {
        "color": "green",
        "value": 12884901888
       }
      ]
     },
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_memory_MemAvailable_bytes",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 7,
   "type": "stat",
   "title": "Mode",
   "description": "evo mode game | server | quiet",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 1,
    "w": 3,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "name"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "evo_mode",
     "legendFormat": "{{mode}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "stat",
   "title": "Profile",
   "description": "llama-swap profile: smart | fast | multi",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 21,
    "y": 1,
    "w": 3,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
