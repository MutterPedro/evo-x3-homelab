     "legendFormat": "{{model}}"
    }
   ]
  },
  {
   "id": 17,
   "type": "row",
   "title": "Model comparison (side by side)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 18,
   "type": "bargauge",
   "title": "Average generation speed (selected time range)",
   "description": "Mean tokens/s over the dashboard's time range while generating. Real usage: mixes easy and hard prompts.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 29,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "suffix: tok/s",
     "min": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "orientation": "horizontal",
    "displayMode": "gradient",
    "showUnfilled": true
   },
   "targets": [
    {
     "refId": "A",
     "expr": "avg by (model)(avg_over_time((rate(llamacpp:tokens_predicted_total{model=~\"$model\"}[2m]) / rate(llamacpp:tokens_predicted_seconds_total{model=~\"$model\"}[2m]) > 0)[$__range:1m]))",
     "legendFormat": "{{model}}",
     "instant": true
    }
   ]
  },
  {
