     "legendFormat": "{{model}}",
     "instant": true
    }
   ]
  },
  {
   "id": 21,
   "type": "table",
   "title": "Models at a glance (selected time range)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 37,
    "w": 24,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Gen tok/s (usage)"
      },
      "properties": [
       {
        "id": "decimals",
        "value": 1
       }
      ]
