   },
   "targets": [
    {
     "refId": "A",
     "expr": "evo_profile",
     "legendFormat": "{{profile}}"
    }
   ]
  },
  {
   "id": 9,
   "type": "row",
   "title": "LLM speed (live usage)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Generation speed per model",
   "description": "Tokens generated per second while a request is running (gaps = idle). Depends on prompt and context length: for a fair comparison use the benchmark in 'Model comparison'.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "suffix: tok/s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(llamacpp:tokens_predicted_total{model=~\"$model\"}[2m]) / rate(llamacpp:tokens_predicted_seconds_total{model=~\"$model\"}[2m])",
     "legendFormat": "{{model}}"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Prompt processing speed per model",
   "description": "How fast the model reads the prompt, per model.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "suffix: tok/s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(llamacpp:prompt_tokens_total{model=~\"$model\"}[2m]) / rate(llamacpp:prompt_seconds_total{model=~\"$model\"}[2m])",
     "legendFormat": "{{model}}"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Speculative decoding acceptance (MTP)",
   "description": "Share of the draft tokens the big model accepted. Higher = faster. Only models with an MTP draft (Flash-Next).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     },
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(llamacpp:spec_decode_num_accepted_tokens_total{model=~\"$model\"}[5m]) / rate(llamacpp:spec_decode_num_draft_tokens_total{model=~\"$model\"}[5m])",
     "legendFormat": "{{model}}"
    }
   ]
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Prompt cache hit ratio",
   "description": "Share of prompt tokens reused instead of recomputed. High in long chats and coding agents.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     },
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(llamacpp:prompt_tokens_cached_total{model=~\"$model\"}[5m]) / (rate(llamacpp:prompt_tokens_cached_total{model=~\"$model\"}[5m]) + rate(llamacpp:prompt_tokens_total{model=~\"$model\"}[5m]))",
     "legendFormat": "{{model}}"
    }
   ]
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Requests running / deferred",
   "description": "Waiting requests mean a model's parallel slots are all busy.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "llamacpp:requests_processing{model=~\"$model\"}",
     "legendFormat": "{{model}} running"
    },
    {
     "refId": "B",
     "expr": "llamacpp:requests_deferred{model=~\"$model\"}",
     "legendFormat": "{{model}} waiting"
    }
   ]
  },
  {
   "id": 15,
   "type": "timeseries",
   "title": "Tokens generated per hour",
   "description": "Output tokens produced per hour, per model.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 12,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 70,
      "spanNulls": false,
      "stacking": {
       "mode": "normal"
      },
      "drawStyle": "bars"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (model)(increase(evo_tokens_total{kind=\"generated\",model=~\"$model\"}[1h]))",
     "legendFormat": "{{model}}",
     "interval": "1h"
    }
   ]
  },
  {
   "id": 16,
   "type": "timeseries",
   "title": "Longest context seen",
   "description": "Largest prompt+answer a loaded model has handled since it started.",
