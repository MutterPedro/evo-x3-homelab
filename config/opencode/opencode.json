      "name": "Local (llama-swap)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "{env:EVO_API_KEY}"
      },
      "compatibility": {
        "maxTokensField": "max_tokens"
      },
      "models": {
        "qwen3.8-flash-next": {
