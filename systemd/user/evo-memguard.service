# Last line of defence against running out of RAM (see bin/evo-memguard).
[Unit]
Description=EVO memory guard (unload/kill models before the system freezes)
After=llama-swap.service

[Service]
Type=simple
EnvironmentFile=@EVO_CONFIG_DIR@/runtime.env
EnvironmentFile=@EVO_CONFIG_DIR@/secrets.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/evo-memguard
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
