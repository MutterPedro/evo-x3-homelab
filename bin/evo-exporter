#!/usr/bin/python3
"""evo-exporter: Prometheus metrics that Grafana's LLM dashboard is built on.

Why it exists: each model runs in its own container on a port llama-swap picks,
and touching an unloaded model through llama-swap would load it. This exporter
asks llama-swap which models are *running* (/running), scrapes only those, and
re-exposes their llama-server metrics with a model="..." label. It cannot wake a
model. It also exposes things only this repo knows: the evo mode and profile, the
last backup, memory-guard events, benchmark results and the cloud prices used for
the money-saved estimate (config/cloud-prices.tsv).

A background thread reads the loaded models every 0.5 s so tokens are counted even when a
model is unloaded between two Prometheus scrapes (losing at most the last half second before an unload).

Token counters are persisted in ~/.local/state/evo/exporter.json as lifetime
totals (evo_tokens_total) that survive model reloads, container restarts and
exporter restarts. Standard library only, so it runs on the system python3.
"""
import json
import os
import re
import sys
import threading
import time
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

VIRTUAL = {"chat", "code", "vision", "fast"}  # profile names, not real models
# llama-server counters we turn into lifetime totals: metric -> kind label
COUNTERS = {
    "llamacpp:prompt_tokens_total": "prompt",
    "llamacpp:tokens_predicted_total": "generated",
    "llamacpp:prompt_tokens_cached_total": "cached",
}
LABEL_RE = re.compile(r"^([a-zA-Z_:][a-zA-Z0-9_:]*)(\{[^}]*\})?\s+(\S+)")


def esc(s):
    return str(s).replace("\\", "\\\\").replace('"', '\\"').replace("\n", " ")


class Collector:
    def __init__(self, fetch, state_dir, config_dir, env, now=time.time):
        self.fetch = fetch          # fetch(url, auth=bool) -> text or None
        self.state_dir = Path(state_dir)
        self.config_dir = Path(config_dir)
        self.env = env
        self.now = now
        self.lock = threading.Lock()
        self.api = f"http://127.0.0.1:{env.get('EVO_LLAMA_SWAP_PORT', '8080')}"
        self.state_file = self.state_dir / "exporter.json"
        self.state = {"totals": {}, "last": {}}
        try:
            self.state = json.loads(self.state_file.read_text())
        except (OSError, ValueError):
            pass
        self.state.setdefault("totals", {})
        self.state.setdefault("last", {})

    # -- helpers --------------------------------------------------------------
    def _json(self, path):
        text = self.fetch(self.api + path, True)
        try:
            return json.loads(text) if text else None
        except ValueError:
            return None

    def _read(self, path, default=""):
        try:
            return Path(path).read_text().strip()
        except OSError:
            return default

    def _account(self, model, name, value):
        """Add the growth of a llama-server counter to the lifetime total.
        Counters restart at 0 when a container restarts: then the whole value is new."""
        last = self.state["last"].setdefault(model, {})
        prev = last.get(name)
        delta = value if prev is None or value < prev else value - prev
        last[name] = value
        tot = self.state["totals"].setdefault(model, {})
        kind = COUNTERS[name]
        tot[kind] = tot.get(kind, 0.0) + delta

    # -- the scrape ------------------------------------------------------------
    def collect(self):
        with self.lock:
            out, seen_meta = [], set()

            def emit(name, typ, helptext, labels, value):
                if name not in seen_meta:
                    seen_meta.add(name)
                    out.append(f"# HELP {name} {helptext}")
                    out.append(f"# TYPE {name} {typ}")
                lab = ",".join(f'{k}="{esc(v)}"' for k, v in labels.items())
                out.append(f"{name}{{{lab}}} {value}" if lab else f"{name} {value}")

            running = (self._json("/running") or {}).get("running", [])
            ok = self._json("/running") is not None
            emit("evo_exporter_up", "gauge", "1 when llama-swap answered", {}, 1 if ok else 0)
            state_of = {r.get("model"): r.get("state") for r in running}

            models_json = self._json("/v1/models") or {}
            known = {m["id"] for m in models_json.get("data", []) if m.get("id")}
            known = {m for m in known if m not in VIRTUAL} | set(state_of)
            for m in sorted(known):
                emit("evo_model_loaded", "gauge", "1 when the model is loaded and ready",
                     {"model": m}, 1 if state_of.get(m) == "ready" else 0)

            changed = False
            for r in running:
                m, st = r.get("model"), r.get("state")
                if st != "ready" or not r.get("proxy"):
                    continue
                text = self.fetch(r["proxy"].rstrip("/") + "/metrics", False)
                if not text:
                    continue
                for line in text.splitlines():
                    if line.startswith("# HELP llamacpp:") or line.startswith("# TYPE llamacpp:"):
                        key = " ".join(line.split()[:3])
                        if key not in seen_meta:
                            seen_meta.add(key)
                            out.append(line)
                        continue
                    mt = LABEL_RE.match(line)
                    if not mt or not mt.group(1).startswith("llamacpp:"):
                        continue
                    name, labels, val = mt.groups()
                    inner = labels[1:-1] if labels else ""
                    inner = (inner + "," if inner else "") + f'model="{esc(m)}"'
                    out.append(f"{name}{{{inner}}} {val}")
                    if name in COUNTERS:
                        try:
                            self._account(m, name, float(val))
                            changed = True
                        except ValueError:
                            pass
            # a model that is not running starts from zero next time it loads
            for m in list(self.state["last"]):
                if state_of.get(m) != "ready":
                    self.state["last"].pop(m)
                    changed = True
            for m, kinds in sorted(self.state["totals"].items()):
                for kind, v in sorted(kinds.items()):
                    emit("evo_tokens_total", "counter",
                         "Lifetime tokens per model (prompt excludes cached, generated, cached)",
                         {"model": m, "kind": kind}, v)
            if changed:
                try:
                    self.state_dir.mkdir(parents=True, exist_ok=True)
                    tmp = self.state_file.with_suffix(".tmp")
                    tmp.write_text(json.dumps(self.state))
                    tmp.replace(self.state_file)
                except OSError:
                    pass

            # evo mode / profile / power profile
            mode = ""
            for line in self._read(self.state_dir / "state.env").splitlines():
                if line.startswith("MODE="):
                    mode = line[5:]
            emit("evo_mode", "gauge", "Current evo mode (game|server|quiet)", {"mode": mode or "unknown"}, 1)
            prof = (self._json("/api/profiles") or {}).get("active") or "none"
            emit("evo_profile", "gauge", "Active llama-swap profile", {"profile": prof}, 1)
            tuned = self._read("/etc/tuned/active_profile", "unknown") or "unknown"
            emit("evo_tuned_profile", "gauge", "Active TuneD profile", {"profile": tuned}, 1)

            # backups, memory guard, benchmarks
            lb = self._read(self.state_dir / "last-backup")
            if lb.isdigit():
                emit("evo_last_backup_timestamp_seconds", "gauge", "Unix time of the last successful backup", {}, lb)
            events = {"soft": 0, "hard": 0}
            last_ev = 0
            for line in self._read(self.state_dir / "memguard.events").splitlines():
                p = line.split()
                if len(p) == 2 and p[1] in events and p[0].isdigit():
                    events[p[1]] += 1
                    last_ev = max(last_ev, int(p[0]))
            for lvl, n in events.items():
                emit("evo_memguard_events_total", "counter", "Memory guard interventions", {"level": lvl}, n)
            try:
                bench = json.loads(self._read(self.state_dir / "bench.json", "{}"))
            except ValueError:
                bench = {}
            for m, b in sorted(bench.items()):
                emit("evo_bench_tokens_per_second", "gauge",
                     "Controlled benchmark (evo bench --all): same prompt for every model",
                     {"model": m, "kind": "generation"}, b.get("generation", 0))
                emit("evo_bench_tokens_per_second", "gauge", "", {"model": m, "kind": "prompt"}, b.get("prompt", 0))
                emit("evo_bench_timestamp_seconds", "gauge", "Unix time of the benchmark", {"model": m}, b.get("ts", 0))

            # money: cloud price per model + electricity assumptions
            try:
                rows = (self.config_dir / "cloud-prices.tsv").read_text().splitlines()
            except OSError:
                rows = []
            for line in rows:
                c = line.split("\t")
                if len(c) < 4 or line.startswith("#") or c[0] == "model":
                    continue
                try:
                    emit("evo_cloud_price_usd_per_mtok", "gauge",
                         "USD per million tokens of the cloud model used as the equivalent (config/cloud-prices.tsv)",
                         {"model": c[0], "cloud_model": c[1], "direction": "input"}, float(c[2]))
                    emit("evo_cloud_price_usd_per_mtok", "gauge", "",
                         {"model": c[0], "cloud_model": c[1], "direction": "output"}, float(c[3]))
                except ValueError:
                    continue
            for name, key, dflt, h in (
                ("evo_electricity_price_brl_per_kwh", "EVO_KWH_PRICE_BRL", "0.90", "Electricity price, BRL per kWh"),
                ("evo_usd_brl", "EVO_USD_BRL", "5.50", "BRL per USD used to convert"),
                ("evo_power_overhead_watts", "EVO_POWER_OVERHEAD_W", "15", "Wall power not reported by the APU sensor (PSU, SSD, fans, Wi-Fi)"),
            ):
                try:
                    emit(name, "gauge", h, {}, float(self.env.get(key, dflt)))
                except ValueError:
                    emit(name, "gauge", h, {}, float(dflt))
            return "\n".join(out) + "\n"


def http_fetch(key):
    def fetch(url, auth=True):
        req = urllib.request.Request(url)
        if auth and key:
            req.add_header("Authorization", f"Bearer {key}")
        try:
            with urllib.request.urlopen(req, timeout=3) as r:
                return r.read().decode("utf-8", "replace")
        except Exception:
            return None
    return fetch


def main():
    env = os.environ
    port = int(env.get("EVO_EXPORTER_PORT", "9102"))
    state_dir = Path(env.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "evo"
    config_dir = Path(env.get("EVO_CONFIG_DIR", Path.home() / ".config/evo"))
    col = Collector(http_fetch(env.get("LLAMA_SWAP_KEY", "")), state_dir, config_dir, env)
    latest = {"text": None}

    def poll():
        # Read the loaded models every half second, not only when Prometheus
        # scrapes (every 15 s): a model unloaded right after a request would
        # otherwise take its token counters with it before we ever saw them.
        while True:
            try:
                latest["text"] = col.collect()
            except Exception as e:  # keep polling whatever happens
                print(f"evo-exporter: poll failed: {e}", file=sys.stderr, flush=True)
            time.sleep(float(env.get("EVO_EXPORTER_POLL_SECONDS", "0.5")))

    threading.Thread(target=poll, daemon=True).start()

    class H(BaseHTTPRequestHandler):
        def do_GET(self):
            if self.path.split("?")[0] != "/metrics":
                self.send_response(404); self.end_headers(); return
            body = (latest["text"] or col.collect()).encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; version=0.0.4")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers(); self.wfile.write(body)

        def log_message(self, *a):
            pass

    print(f"evo-exporter: http://127.0.0.1:{port}/metrics", flush=True)
    ThreadingHTTPServer(("127.0.0.1", port), H).serve_forever()


if __name__ == "__main__":
    main()
