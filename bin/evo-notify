#!/usr/bin/env bash
# Run `evo mode <mode>` from a desktop launcher and show the result as a notification.
set -uo pipefail
mode="${1:?usage: evo-notify game|server|quiet}"
log="$(mktemp)"
"$HOME/.local/bin/evo" mode "$mode" >"$log" 2>&1
rc=$?
icon=dialog-information
((rc == 0)) || icon=dialog-error
msg="$(sed 's/\x1b\[[0-9;]*m//g' "$log" | tail -n 4)"
rm -f "$log"
notify-send -a EVO -i "$icon" "EVO: ${mode} mode" "$msg" 2>/dev/null || echo "$msg"
exit "$rc"
