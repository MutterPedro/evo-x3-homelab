# Grafana: dashboards for GPU/RAM/temps/tokens per second (http://evo-x3:@EVO_GRAFANA_PORT@)
[Unit]
Description=Grafana
After=prometheus.service

[Container]
Image=docker.io/grafana/grafana-oss:latest
ContainerName=grafana
Network=host
UserNS=keep-id:uid=472,gid=472
Volume=@EVO_AI_DIR@/grafana:/var/lib/grafana:Z
Volume=@EVO_CONFIG_DIR@/grafana/provisioning:/etc/grafana/provisioning:ro,Z
Volume=@EVO_CONFIG_DIR@/grafana/dashboards:/etc/grafana/dashboards:ro,Z
Environment=GF_SERVER_HTTP_PORT=@EVO_GRAFANA_PORT@
Environment=GF_SECURITY_ADMIN_USER=admin
Environment=GF_SECURITY_ADMIN_PASSWORD=@GRAFANA_ADMIN_PASSWORD@
Environment=GF_USERS_ALLOW_SIGN_UP=false
Environment=GF_ANALYTICS_REPORTING_ENABLED=false
Environment=GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/etc/grafana/dashboards/evo-x3.json
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
